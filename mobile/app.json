{
  "expo": {
    "name": "CarFable",
    "slug": "carfable",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carfable",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.carfable.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.carfable.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "CarFable uses the camera to photograph receipts, fuel pumps, and your car.",
        "NSPhotoLibraryUsageDescription": "CarFable needs your photo library to attach photos to your car's history.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e549ac51-eebd-4b0c-8c7a-6755f692a668"
      }
    },
    "owner": "joseprupi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e549ac51-eebd-4b0c-8c7a-6755f692a668"
    }
  }
}