# My Garage backend — PRODUCTION env template (Cloud Run)
# Copy/translate these into Cloud Run env vars or Secret Manager secrets.
# DO NOT commit real values. This file holds placeholders only.
#
# Naming: each var maps 1:1 (case-insensitive) to a field in app/config.py.

# --- Database (Cloud SQL Postgres) ---------------------------------------
# Use the psycopg (v3) driver. Two common shapes:
#  1) Cloud SQL via Unix socket (Cloud Run --add-cloudsql-instances):
#     postgresql+psycopg://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
#  2) Direct TCP (private IP / proxy):
#     postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql+psycopg://carsocial:CHANGE_ME@/carsocial?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Auth ----------------------------------------------------------------
# Strong random secret used to sign JWTs. Store in Secret Manager.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Google OAuth client ID (the prod web client). Needed for Google login.
GOOGLE_CLIENT_ID=your-prod-oauth-client-id.apps.googleusercontent.com

# --- Media storage (GCS via boto3 S3-compatible API) ---------------------
# GCS XML/S3 interop endpoint (same for every bucket/project):
STORAGE_ENDPOINT_URL=https://storage.googleapis.com
# GCS region of the bucket (e.g. us-central1 / us / auto). boto3 needs a value.
STORAGE_REGION=auto
# Target bucket name.
STORAGE_BUCKET=mygarage-media-prod
# HMAC key for a service account with object admin on the bucket (Secret Manager).
STORAGE_ACCESS_KEY_ID=GOOG_HMAC_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_HMAC_SECRET
# Public base URL media is served from. In prod the frontend should proxy
# media (mirroring the local /media rewrite) so the browser never hits GCS
# directly. Set to your frontend media path (e.g. /media) or a public
# bucket/CDN URL (e.g. https://storage.googleapis.com/mygarage-media-prod).
PUBLIC_MEDIA_BASE_URL=/media
# Max upload size in bytes (10 MiB default; raise if needed for PDFs/photos).
MAX_UPLOAD_BYTES=10485760

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed browser origins (the deployed frontend).
# No trailing slashes. Example with apex + www:
CORS_ORIGINS=https://app.example.com,https://www.example.com

# --- Server --------------------------------------------------------------
# Cloud Run injects PORT automatically; only set this for local container runs.
# PORT=8080
